{
  "name": "designio",
  "version": "0.1.0",
  "private": true,
  "description": "DesignIO — a personal 3D clothing design tool (CLO3D / Browzwear-style). Foundation: 3D viewport, mannequin, and real-time cloth draping.",
  "author": "Zayan Khan <khanzayan_123@hotmail.com>",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "npm run build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "npm run build && electron scripts/capture.cjs docs/preview.png 8000",
    "golden": "npm run build && electron scripts/golden.cjs --check",
    "golden:update": "npm run build && electron scripts/golden.cjs --update",
    "capture": "npm run build && node scripts/capture-readme.cjs",
    "render": "node scripts/render.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.zayankhan.designio",
    "productName": "DesignIO",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.designio.app/${channel}"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "draco3dgltf": "^1.5.7",
    "fflate": "^0.8.3",
    "lucide": "^1.23.0",
    "motion": "^12.42.2",
    "split.js": "^1.6.5",
    "three": "^0.185.1",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
